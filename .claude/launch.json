{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "proto",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "redesign/prototypes-v3/tools/serve.mjs"
      ],
      "port": 3456
    }
  ]
}
