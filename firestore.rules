rules_version = '2';

// All reads and writes go through the Firebase Admin SDK on the server
// (Next.js route handlers and server components), which bypasses these rules.
// The client SDK is only used for Google sign-in, so no direct client access
// to Firestore is needed. Deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
