# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin (server-side only — NOT NEXT_PUBLIC_)
ADMIN_EMAIL=your-admin-email@gmail.com

# Revalidation
REVALIDATION_SECRET=

# Canonical site origin (optional). Used for sitemap, canonical + Open Graph URLs.
# Leave unset on Vercel to use the project's production URL automatically;
# set it once a custom domain exists, e.g. https://agoohandruks.com
NEXT_PUBLIC_SITE_URL=
